    {
      "parameters": {
        "jsCode": "const first = $input.first()?.json ?? {};\n\n// Hostname that was queried (the DoH response echoes it in Question[0].name)\nconst subdomain = (\n  first.subdomain ||\n  first.fqdn ||\n  first.Question?.[0]?.name ||\n  \"\"\n).replace(/\\.$/, \"\") || null;\n\n// Keep only A records (type 1). CNAME entries (type 5) contain hostnames, not IPs.\nconst ips = [...new Set(\n  (Array.isArray(first.Answer) ? first.Answer : [])\n    .filter(ans => ans.type === 1 && ans.data)\n    .map(ans => ans.data)\n)];\n\n// Fallback: an IP supplied by an earlier node\nif (ips.length === 0 && first.ip) ips.push(first.ip);\n\n// No IP found: emit one item with ip: null so the downstream IF node can skip it\nif (ips.length === 0) return [{ json: { subdomain, ip: null } }];\n\nreturn ips.map(ip => ({ json: { subdomain, ip } }));"
      },
